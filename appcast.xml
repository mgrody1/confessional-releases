        <item>
            <title>Confessional 1.53.0</title>
            <pubDate>Wed, 28 Oct 2026 19:42:38 -0400</pubDate>
            <sparkle:version>202610281939</sparkle:version>
            <sparkle:shortVersionString>1.53.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<ul><li>Screenshots from the right Zoom window: Zoom&#x27;s home window is never picked, Zoom in a browser is recognised, and a better match found mid-call is switched to.</li><li>Live captions come back after pausing when the Mac was busy.</li><li>Easier crash reports (Copy Report to paste into a message) and step-by-step notes to trace crashes; microphone setup better protected.</li></ul>]]></description>
            <enclosure url="https://github.com/mgrody1/confessional-releases/releases/download/v1.53.0/Confessional-1.53.0.zip" sparkle:edSignature="gQPw/LOAlfc7QEzs4pTOdD8R1PvKZ3ECtKDP7FMfy5atOF162PQ7uUtg8gGGLy8xFn1jE9+bE+O+aqBnDzQ0Cg==" length="32128613" type="application/octet-stream"/>
